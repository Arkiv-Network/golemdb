+/// Roots released per commit, replayed W commits later (A1).
+const RELEASES: Table = Table("GcReleases");
+/// Nodes that reached zero per commit, deleted W commits later (A2).
+const PENDING: Table = Table("GcPending");
+/// A2: a node at zero awaiting deletion stores `MARK ‖ death commit` as its count.
+const MARK: u8 = 0xff;
+
+fn encode(nodes: &[Node]) -> Vec<u8> {
+    nodes.iter().flat_map(|node| node.key()).collect()
+}
+
+fn decode(bytes: &[u8]) -> Vec<Node> {
+    bytes
+        .chunks(33)
+        .map(|key| Node {
+            kind: match key[0] {
+                0 => Kind::Cell,
+                1 => Kind::Index,
+                2 => Kind::Bitmap,
+                _ => Kind::Container,
+            },
+            hash: key[1..].try_into().unwrap(),
+        })
+        .collect()
+}
+
+fn marker(commit: u64) -> [u8; 9] {
+    let mut bytes = [MARK; 9];
+    bytes[1..].copy_from_slice(&commit.to_be_bytes());
+    bytes
+}
+
+/// A2: delete the nodes that reached zero at commits `≤ commit − W` and are
+/// still at zero from that death, once per batch of K commits.
+fn sweep_deferred<R: ReadTransaction>(tx: &mut Buffered<'_, R>, commit: u64) -> Result<()> {
+    let Config { w, k, .. } = *config();
+    let Some(due) = commit.checked_sub(w) else {
+        return Ok(());
+    };
+    if due % k != 0 {
+        return Ok(());
+    }
+    for death in due.saturating_sub(k - 1)..=due {
+        let Some(bytes) = tx.get(PENDING, &death.to_be_bytes())? else {
+            continue;
+        };
+        tx.delete_existing(PENDING, &death.to_be_bytes());
+        for node in decode(&bytes) {
+            if tx.get(NODE_REFS, &node.key())?.as_deref() == Some(marker(death).as_slice()) {
+                tx.delete_existing(NODE_REFS, &node.key());
+                tx.delete_existing(node.kind.table(), &node.hash);
+            }
+        }
+    }
+    Ok(())
+}
