--- /dev/null
+++ b/crates/integration-tests/tests/gcwin.rs
@@ -0,0 +1,153 @@
+//! Windowed reference counting check (benchmark scratch copy only). Run with
+//! GOLEMDB_GCA=window|defer, GOLEMDB_GCA_W and GOLEMDB_GCA_K set. After every
+//! commit, stored trie rows must be exactly the rows reachable from the roots of
+//! the last W commits (window, and defer with K = 1), or lie between those and
+//! the rows reachable from the last W + K − 1 commits (defer with K > 1).
+use std::collections::BTreeSet;
+
+use golemdb_branch::{Branches, CommitId, create_genesis_in, read_head_state};
+use golemdb_cells::{CellKey, CellNameRef, CellType, CellValue, CellValueRef, tables};
+use golemdb_index::tables as itables;
+use golemdb_merkle::{BranchNodeCompact, Hash, Keccak256Hasher, RootRef};
+use golemdb_storage::{MemoryDatabase, ReadTransaction, Database, Table, WriteTransaction, scan_prefix};
+
+const HASH: Keccak256Hasher = Keccak256Hasher;
+
+type Row = (Table, Hash);
+
+/// Physical roots of one commit: state, index, and every term's bitmap root.
+fn roots(tx: &impl ReadTransaction) -> Vec<Row> {
+    let head = read_head_state(tx).unwrap();
+    let mut out = vec![(tables::CELL_TRIE, head.state_root), (itables::INDEX_TRIE, head.index_root)];
+    for row in scan_prefix(tx, itables::INDEX, vec![]).unwrap() {
+        let hash: Hash = row.unwrap().1.try_into().unwrap();
+        let table = if tx.get(itables::BITMAP_CONTAINER, &hash).unwrap().is_some() {
+            itables::BITMAP_CONTAINER
+        } else {
+            itables::BITMAP_TRIE
+        };
+        out.push((table, hash));
+    }
+    out
+}
+
+fn reach(tx: &impl ReadTransaction, roots: &[Row], strict: bool, out: &mut BTreeSet<Row>) {
+    let mut stack: Vec<(Row, bool)> = roots.iter().map(|&row| (row, true)).collect();
+    while let Some(((table, hash), root)) = stack.pop() {
+        let Some(bytes) = tx.get(table, &hash).unwrap() else {
+            // Only a cell/index root that is a leaf or empty has no row.
+            assert!(!strict || (root && table != itables::BITMAP_TRIE), "reachable row missing in {table:?}");
+            continue;
+        };
+        if !out.insert((table, hash)) || table == itables::BITMAP_CONTAINER {
+            continue;
+        }
+        let children: Vec<RootRef<32>> = if table == itables::BITMAP_TRIE {
+            let node = BranchNodeCompact::<6>::decode(&bytes).unwrap();
+            (0..16)
+                .filter_map(|slot| node.child(slot))
+                .map(|child| match child {
+                    RootRef::Branch(h) => RootRef::Branch(h),
+                    RootRef::Leaf(leaf) => {
+                        stack.push(((itables::BITMAP_CONTAINER, leaf.hash), false));
+                        RootRef::Empty
+                    }
+                    RootRef::Empty => RootRef::Empty,
+                })
+                .collect()
+        } else {
+            let node = BranchNodeCompact::<32>::decode(&bytes).unwrap();
+            (0..16).filter_map(|slot| node.child(slot)).collect()
+        };
+        for child in children {
+            if let RootRef::Branch(h) = child {
+                stack.push(((table, h), false));
+            }
+        }
+    }
+}
+
+fn stored(tx: &impl ReadTransaction) -> BTreeSet<Row> {
+    let mut rows = BTreeSet::new();
+    for table in [
+        tables::CELL_TRIE,
+        itables::INDEX_TRIE,
+        itables::BITMAP_TRIE,
+        itables::BITMAP_CONTAINER,
+    ] {
+        for row in scan_prefix(tx, table, vec![]).unwrap() {
+            rows.insert((table, row.unwrap().0.try_into().unwrap()));
+        }
+    }
+    rows
+}
+
+#[test]
+fn windowed_refcounts_keep_exactly_the_window() {
+    let mode = std::env::var("GOLEMDB_GCA").unwrap_or_default();
+    if mode != "window" && mode != "defer" {
+        return;
+    }
+    let env = |name: &str, default: u64| {
+        std::env::var(name).ok().map(|v| v.parse().unwrap()).unwrap_or(default)
+    };
+    let (w, k) = (env("GOLEMDB_GCA_W", 0), env("GOLEMDB_GCA_K", 1));
+    let span = if mode == "defer" { w + k - 1 } else { w };
+    let db = MemoryDatabase::new();
+    let mut tx = db.begin_write().unwrap();
+    create_genesis_in(&mut tx, &HASH, []).unwrap();
+    tx.commit().unwrap();
+    let branches = Branches::new(db.clone(), HASH).unwrap();
+    let mut history = vec![roots(&db.begin_read().unwrap())];
+    let mut seed = 7u64;
+    let mut rand = move |n: u64| {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        (seed >> 33) % n
+    };
+    for commit in 1..=300u64 {
+        let branch = branches.begin().unwrap();
+        branches
+            .write(branch, |cells| {
+                for _ in 0..30 {
+                    // Few values per attribute, so bitmaps and nodes often return
+                    // to earlier states (hash-key sharing and revival).
+                    let id = golemdb_index::path::join(rand(3), 64 + rand(200) as u16).unwrap();
+                    let name = ["tag", "owner", "note"][rand(3) as usize];
+                    let key = CellKey::new(id, CellNameRef::raw(name.as_bytes()));
+                    if rand(3) == 0 {
+                        cells.delete(key);
+                    } else {
+                        let value: CellValue = CellValueRef::new(
+                            CellType::Str,
+                            format!("v{}", rand(4)).as_bytes(),
+                            name != "note",
+                        )
+                        .unwrap()
+                        .into();
+                        cells.put(key, value);
+                    }
+                }
+                Ok::<_, ()>(())
+            })
+            .unwrap();
+        assert_eq!(branches.commit(branch).unwrap(), CommitId::new(commit));
+        let tx = db.begin_read().unwrap();
+        history.push(roots(&tx));
+        let rows = stored(&tx);
+        let window = |n: u64, strict: bool| {
+            let mut set = BTreeSet::new();
+            for c in commit.saturating_sub(n)..=commit {
+                reach(&tx, &history[c as usize], strict, &mut set);
+            }
+            set
+        };
+        let retained = window(w, true);
+        if span == w {
+            assert_eq!(rows, retained, "commit {commit}: stored rows differ from the window's");
+        } else {
+            assert!(retained.is_subset(&rows), "commit {commit}: a retained row was deleted");
+            let outer = window(span, false);
+            assert!(rows.is_subset(&outer), "commit {commit}: a row outlived W + K − 1");
+        }
+    }
+}
