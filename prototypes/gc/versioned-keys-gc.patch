diff --git a/crates/integration-tests/tests/gcproto.rs b/crates/integration-tests/tests/gcproto.rs
new file mode 100644
index 0000000..e4a7785
--- /dev/null
+++ b/crates/integration-tests/tests/gcproto.rs
@@ -0,0 +1,193 @@
+//! GC prototype check (benchmark scratch copy only). Run with GOLEMDB_GC=stale|sweep,
+//! GOLEMDB_GC_W and GOLEMDB_GC_K set. After every commit, stored trie rows must be
+//! exactly the rows reachable from the retained roots (`stale`), or lie between the
+//! rows reachable from the head and those reachable from the last W + 2K roots (`sweep`).
+use std::collections::{BTreeMap, BTreeSet};
+
+use golemdb_branch::{Branches, CommitId, Head, read_roots, write_head};
+use golemdb_cells::{CellKey, CellNameRef, CellType, CellValue, CellValueRef, tables};
+use golemdb_index::{BITMAP_TRIE_PATH_BYTES, IndexTerm, tables as itables};
+use golemdb_merkle::{BranchNodeCompact, HashProvider, Keccak256Hasher, RootRef, version_key};
+use golemdb_storage::{MemoryStore, ReadTransaction, Store, Table, WriteTransaction, scan_prefix};
+
+const HASH: Keccak256Hasher = Keccak256Hasher;
+
+fn pack(route: &[u8]) -> Vec<u8> {
+    let packed = route
+        .chunks(2)
+        .map(|pair| (pair[0] << 4) | pair.get(1).copied().unwrap_or(0));
+    [vec![route.len() as u8], packed.collect()].concat()
+}
+
+/// Rows reachable from `root` in `table` (and, for bitmap tries, their containers).
+fn reach<const N: usize>(
+    tx: &impl ReadTransaction,
+    table: Table,
+    ns: &[u8],
+    root: RootRef<N>,
+    containers: bool,
+    strict: bool,
+    out: &mut BTreeSet<(Table, Vec<u8>)>,
+) {
+    let mut stack = vec![(root, Vec::new())];
+    while let Some((root, route)) = stack.pop() {
+        match root {
+            RootRef::Empty => {}
+            RootRef::Leaf(leaf) => {
+                if containers {
+                    out.insert((
+                        itables::BITMAP_CONTAINER,
+                        version_key(leaf.commit, ns, &leaf.path),
+                    ));
+                }
+            }
+            RootRef::Branch(branch) => {
+                let key = version_key(branch.commit, ns, &pack(&route));
+                let Some(bytes) = tx.get(table, &key).unwrap() else {
+                    assert!(!strict, "reachable row {key:?} in {table:?} is not stored");
+                    continue;
+                };
+                if !out.insert((table, key)) {
+                    continue;
+                }
+                let node = BranchNodeCompact::<N>::decode(&bytes).unwrap();
+                let prefix = (0..node.prefix_len() as usize)
+                    .map(|i| (node.prefix()[i / 2] >> (4 * (1 - i % 2))) & 15);
+                let base: Vec<u8> = route.iter().copied().chain(prefix).collect();
+                for slot in 0..16 {
+                    if let Some(child) = node.child(slot) {
+                        stack.push((child, [&base[..], &[slot]].concat()));
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Rows reachable from commit `c`'s roots, given that commit's bitmap roots.
+fn reachable(
+    tx: &impl ReadTransaction,
+    c: u64,
+    bitmaps: &[(Vec<u8>, RootRef<BITMAP_TRIE_PATH_BYTES>)],
+    strict: bool,
+    out: &mut BTreeSet<(Table, Vec<u8>)>,
+) {
+    let roots = read_roots(tx, CommitId::new(c)).unwrap().unwrap();
+    reach(tx, tables::CELL_TRIE, &[], roots.state, false, strict, out);
+    reach(tx, itables::INDEX_TRIE, &[], roots.index, false, strict, out);
+    for (ns, root) in bitmaps {
+        reach(tx, itables::BITMAP_TRIE, ns, *root, true, strict, out);
+    }
+}
+
+fn stored(tx: &impl ReadTransaction) -> BTreeSet<(Table, Vec<u8>)> {
+    let mut rows = BTreeSet::new();
+    for table in [
+        tables::CELL_TRIE,
+        itables::INDEX_TRIE,
+        itables::BITMAP_TRIE,
+        itables::BITMAP_CONTAINER,
+    ] {
+        for row in scan_prefix(tx, table, vec![]).unwrap() {
+            rows.insert((table, row.unwrap().0));
+        }
+    }
+    rows
+}
+
+fn bitmap_roots(tx: &impl ReadTransaction) -> Vec<(Vec<u8>, RootRef<BITMAP_TRIE_PATH_BYTES>)> {
+    scan_prefix(tx, itables::INDEX, vec![])
+        .unwrap()
+        .map(|row| {
+            let (term, value) = row.unwrap();
+            let ns = IndexTerm::decode(&term).unwrap().routing_path(&HASH).to_vec();
+            (ns, RootRef::decode(&value).unwrap())
+        })
+        .collect()
+}
+
+#[test]
+fn gc_prototype_keeps_exactly_the_retained_rows() {
+    let mode = std::env::var("GOLEMDB_GC").unwrap_or_default();
+    if mode.is_empty() || mode == "none" {
+        return;
+    }
+    let env = |name: &str, default: u64| {
+        std::env::var(name).ok().map(|v| v.parse().unwrap()).unwrap_or(default)
+    };
+    let (w, k) = (env("GOLEMDB_GC_W", 0), env("GOLEMDB_GC_K", 50));
+    let db = MemoryStore::new();
+    let mut tx = db.begin_write().unwrap();
+    let empty = HASH.hash(&[]);
+    let head = Head {
+        commit_id: CommitId::new(0),
+        state_root: empty,
+        index_root: empty,
+    };
+    write_head(&mut tx, &head).unwrap();
+    tx.commit().unwrap();
+    let branches = Branches::new(db.clone(), HASH).unwrap();
+    let mut bitmaps = BTreeMap::new();
+    let mut seed = 1u64;
+    let mut rand = move |n: u64| {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+        (seed >> 33) % n
+    };
+    for commit in 1..=200u64 {
+        let branch = branches.begin().unwrap();
+        branches
+            .write(branch, |cells| {
+                for _ in 0..40 {
+                    // Records over three bitmap containers; a few terms per attribute.
+                    let id = golemdb_index::path::join(rand(3), 64 + rand(300) as u16).unwrap();
+                    let name = ["tag", "owner", "note"][rand(3) as usize];
+                    let key = CellKey::new(id, CellNameRef::raw(name.as_bytes()));
+                    if rand(4) == 0 {
+                        cells.delete(key);
+                    } else {
+                        let value: CellValue = CellValueRef::new(
+                            CellType::Str,
+                            format!("v{}", rand(6)).as_bytes(),
+                            name != "note",
+                        )
+                        .unwrap()
+                        .into();
+                        cells.put(key, value);
+                    }
+                }
+                Ok::<_, ()>(())
+            })
+            .unwrap();
+        assert_eq!(branches.commit(branch).unwrap(), CommitId::new(commit));
+        let tx = db.begin_read().unwrap();
+        bitmaps.insert(commit, bitmap_roots(&tx));
+        let rows = stored(&tx);
+        // Every root inside the window must be fully stored.
+        let mut retained = BTreeSet::new();
+        for c in commit.saturating_sub(w).max(1)..=commit {
+            reachable(&tx, c, &bitmaps[&c], true, &mut retained);
+        }
+        let mut window = BTreeSet::new();
+        let span = if mode == "sweep" { w + 2 * k } else { w };
+        for c in commit.saturating_sub(span).max(1)..=commit {
+            reachable(&tx, c, &bitmaps[&c], false, &mut window);
+        }
+        if mode == "marksweep" {
+            let n = env("GOLEMDB_GC_N", 50);
+            let mut head = BTreeSet::new();
+            reachable(&tx, commit, &bitmaps[&commit], true, &mut head);
+            if commit % n == 0 {
+                assert_eq!(rows, head, "commit {commit}: sweep left other rows than the head's");
+            } else {
+                assert!(head.is_subset(&rows), "commit {commit}: a live row was deleted");
+            }
+        } else if mode == "stale" || mode == "diffwalk" {
+            assert_eq!(rows, window, "commit {commit}: stored rows differ from the window's");
+        } else {
+            assert!(retained.is_subset(&rows), "commit {commit}: a live row was deleted");
+            if commit % 50 == 0 {
+                eprintln!("commit {commit}: {} stored, {} retained", rows.len(), retained.len());
+            }
+        }
+    }
+}
