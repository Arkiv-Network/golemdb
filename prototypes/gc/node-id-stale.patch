+#[test]
+fn durable_queue_and_reader_snapshot_survive_process_restart() {
+    if std::env::var("GOLEMDB_GC").as_deref() != Ok("stale") {
+        return;
+    }
+    let directory = tempfile::tempdir().unwrap();
+    let run = |phase: &str| {
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "durable_worker", "--ignored", "--nocapture"])
+            .env("NODE_ID_TEST_DB", directory.path())
+            .env("NODE_ID_TEST_PHASE", phase)
+            .env(
+                "GOLEMDB_LAYOUT",
+                if phase == "wrong-layout" {
+                    if golemdb_merkle::physical::node_ids() {
+                        "version-path"
+                    } else {
+                        "node-id"
+                    }
+                } else if golemdb_merkle::physical::node_ids() {
+                    "node-id"
+                } else {
+                    "version-path"
+                },
+            )
+            .env(
+                "GOLEMDB_GC_CHUNKS",
+                if phase == "drain" { "32" } else { "1" },
+            )
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+    };
+    run("init");
+    run("wrong-layout");
+    let store = golemdb_storage_mdbx::MdbxStore::open(directory.path()).unwrap();
+    let snapshot = store.begin_read().unwrap();
+    assert!(
+        scan_prefix(&snapshot, Table("Stale"), vec![])
+            .unwrap()
+            .count()
+            > 0
+    );
+    let old_head = golemdb_branch::read_head_state(&snapshot)
+        .unwrap()
+        .commit_id;
+    let old_bitmaps = bitmap_roots(&snapshot);
+    let mut before = BTreeSet::new();
+    reachable(&snapshot, old_head.get(), &old_bitmaps, true, &mut before);
+    run("resume");
+    run("drain");
+    let mut after = BTreeSet::new();
+    reachable(&snapshot, old_head.get(), &old_bitmaps, true, &mut after);
+    assert_eq!(before, after);
+    let current = store.begin_read().unwrap();
+    assert!(golemdb_branch::read_head_state(&current).unwrap().commit_id > old_head);
+}
