diff --git a/crates/branch/src/gcproto.rs b/crates/branch/src/gcproto.rs
new file mode 100644
index 0000000..00f1e6b
--- /dev/null
+++ b/crates/branch/src/gcproto.rs
@@ -0,0 +1,220 @@
+//! Experimental, transactionally durable stale lists shared by both layouts.
+//! GOLEMDB_GC=stale enables collection. W retains W old commits plus head.
+//! Optional GOLEMDB_GC_CHUNKS limits chunks consumed per publication; remaining
+//! chunks are the durable continuation, including after abort or process restart.
+use std::sync::OnceLock;
+
+use golemdb_storage::{ReadCursor, StorageError, Table, WriteTransaction};
+
+use crate::Result;
+
+const STALE: Table = Table("Stale");
+const ROOTS: Table = Table("Roots");
+const CHUNK: usize = 128;
+const TABLES: [Table; 4] = [
+    golemdb_cells::tables::CELL_TRIE,
+    golemdb_index::tables::INDEX_TRIE,
+    golemdb_index::tables::BITMAP_TRIE,
+    golemdb_index::tables::BITMAP_CONTAINER,
+];
+
+struct Config {
+    enabled: bool,
+    window: u64,
+    chunks: u64,
+}
+
+fn config() -> &'static Config {
+    static CONFIG: OnceLock<Config> = OnceLock::new();
+    CONFIG.get_or_init(|| {
+        let number = |name, fallback| {
+            std::env::var(name)
+                .map(|v| v.parse().expect("integer GC setting"))
+                .unwrap_or(fallback)
+        };
+        let enabled = match std::env::var("GOLEMDB_GC").as_deref() {
+            Err(std::env::VarError::NotPresent) | Ok("none") => false,
+            Ok("stale") => true,
+            other => panic!("this comparison supports GOLEMDB_GC=none|stale: {other:?}"),
+        };
+        let chunks = number("GOLEMDB_GC_CHUNKS", u64::MAX);
+        assert!(chunks > 0, "GC must make progress");
+        Config {
+            enabled,
+            window: number("GOLEMDB_GC_W", 0),
+            chunks,
+        }
+    })
+}
+
+pub(crate) fn enabled() -> bool {
+    config().enabled
+}
+
+fn invalid() -> StorageError {
+    StorageError::Backend("malformed experimental stale list".into())
+}
+
+fn decode(mut bytes: &[u8]) -> golemdb_storage::Result<Vec<(u8, Vec<u8>)>> {
+    let mut nodes = Vec::new();
+    while !bytes.is_empty() {
+        let [tag, length, rest @ ..] = bytes else {
+            return Err(invalid());
+        };
+        if usize::from(*tag) >= TABLES.len() {
+            return Err(invalid());
+        }
+        let (key, tail) = rest
+            .split_at_checked(usize::from(*length))
+            .ok_or_else(invalid)?;
+        if key.is_empty() {
+            return Err(invalid());
+        }
+        nodes.push((*tag, key.to_vec()));
+        bytes = tail;
+    }
+    Ok(nodes)
+}
+
+/// Publishes stale chunks and consumes eligible chunks in the caller's writer.
+/// No process-global queue state is changed before commit succeeds.
+pub(crate) fn collect(
+    tx: &mut impl WriteTransaction,
+    head: u64,
+    dead: &[(Table, Vec<Vec<u8>>)],
+) -> Result<()> {
+    collect_with(tx, head, dead, config())
+}
+
+fn collect_with(
+    tx: &mut impl WriteTransaction,
+    head: u64,
+    dead: &[(Table, Vec<Vec<u8>>)],
+    cfg: &Config,
+) -> Result<()> {
+    if !cfg.enabled {
+        return Ok(());
+    }
+    let mut nodes = Vec::new();
+    for (table, keys) in dead {
+        let tag = TABLES
+            .iter()
+            .position(|candidate| candidate == table)
+            .ok_or_else(invalid)? as u8;
+        nodes.extend(keys.iter().cloned().map(|key| (tag, key)));
+    }
+    nodes.sort();
+    nodes.dedup();
+    for (index, chunk) in nodes.chunks(CHUNK).enumerate() {
+        let index = u32::try_from(index).map_err(|_| invalid())?;
+        let key = [&head.to_be_bytes()[..], &index.to_be_bytes()].concat();
+        let mut bytes = Vec::new();
+        for (tag, key) in chunk {
+            bytes.push(*tag);
+            bytes.push(u8::try_from(key.len()).map_err(|_| invalid())?);
+            bytes.extend_from_slice(key);
+        }
+        tx.append(STALE, &key, &bytes)?;
+    }
+    if let Some(horizon) = head.checked_sub(cfg.window) {
+        for _ in 0..cfg.chunks {
+            let Some((key, bytes)) = tx.cursor(STALE, b"")?.next()? else {
+                break;
+            };
+            if key.len() != 12 {
+                return Err(invalid().into());
+            }
+            let replaced = u64::from_be_bytes(key[..8].try_into().unwrap());
+            if replaced > horizon {
+                break;
+            }
+            for (tag, node) in decode(&bytes)? {
+                tx.delete(TABLES[usize::from(tag)], &node)?;
+            }
+            tx.delete(STALE, &key)?;
+        }
+    }
+    let first = head.saturating_sub(cfg.window);
+    loop {
+        let Some((key, _)) = tx.cursor(ROOTS, b"")?.next()? else {
+            break;
+        };
+        if key.len() != 8 {
+            return Err(invalid().into());
+        }
+        if u64::from_be_bytes(key[..].try_into().unwrap()) >= first {
+            break;
+        }
+        tx.delete(ROOTS, &key)?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use golemdb_storage::{MemoryStore, ReadTransaction, Store, scan_prefix};
+
+    #[test]
+    fn bounded_collection_resumes_from_committed_queue_after_abort() {
+        let store = MemoryStore::new();
+        let mut tx = store.begin_write().unwrap();
+        for id in 1u64..=4 {
+            tx.put(TABLES[0], &id.to_be_bytes(), b"node").unwrap();
+        }
+        let chunks = [(0u32, [1u64, 2]), (1, [3, 4])];
+        for (chunk, ids) in chunks {
+            let key = [&1u64.to_be_bytes()[..], &chunk.to_be_bytes()].concat();
+            let bytes: Vec<u8> = ids
+                .into_iter()
+                .flat_map(|id| [vec![0, 8], id.to_be_bytes().to_vec()].concat())
+                .collect();
+            tx.append(STALE, &key, &bytes).unwrap();
+        }
+        tx.commit().unwrap();
+        let cfg = Config {
+            enabled: true,
+            window: 0,
+            chunks: 1,
+        };
+        let mut aborted = store.begin_write().unwrap();
+        collect_with(&mut aborted, 2, &[], &cfg).unwrap();
+        assert!(
+            aborted
+                .get(TABLES[0], &1u64.to_be_bytes())
+                .unwrap()
+                .is_none()
+        );
+        drop(aborted);
+        let read = store.begin_read().unwrap();
+        assert_eq!(scan_prefix(&read, STALE, vec![]).unwrap().count(), 2);
+        assert_eq!(scan_prefix(&read, TABLES[0], vec![]).unwrap().count(), 4);
+        let mut tx = store.begin_write().unwrap();
+        collect_with(&mut tx, 2, &[], &cfg).unwrap();
+        tx.commit().unwrap();
+        // A new collector has no volatile progress state to restore.
+        let mut tx = store.begin_write().unwrap();
+        collect_with(
+            &mut tx,
+            3,
+            &[],
+            &Config {
+                enabled: true,
+                window: 0,
+                chunks: 1,
+            },
+        )
+        .unwrap();
+        tx.commit().unwrap();
+        let read = store.begin_read().unwrap();
+        assert_eq!(scan_prefix(&read, STALE, vec![]).unwrap().count(), 0);
+        assert_eq!(scan_prefix(&read, TABLES[0], vec![]).unwrap().count(), 0);
+    }
+
+    #[test]
+    fn malformed_stale_chunks_return_errors() {
+        for bytes in [&[0u8][..], &[4, 1, 9], &[0, 8, 9], &[0, 0]] {
+            assert!(decode(bytes).is_err());
+        }
+    }
+}
