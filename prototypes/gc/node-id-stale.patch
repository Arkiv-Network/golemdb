+#[test]
+fn discarded_and_competing_seals_do_not_publish_ids_or_stale_lists() {
+    if std::env::var("GOLEMDB_GC").as_deref() != Ok("stale") {
+        return;
+    }
+    let store = MemoryStore::new();
+    let mut tx = store.begin_write().unwrap();
+    let empty = HASH.hash(&[]);
+    write_head(
+        &mut tx,
+        &Head {
+            commit_id: CommitId::new(0),
+            state_root: empty,
+            index_root: empty,
+        },
+    )
+    .unwrap();
+    tx.commit().unwrap();
+    let branches = Branches::new(store.clone(), HASH).unwrap();
+    let stage = |text: &str| {
+        let branch = branches.begin().unwrap();
+        branches
+            .write(branch, |cells| {
+                for id in 64..96 {
+                    cells.put(
+                        CellKey::new(id, CellNameRef::raw(b"tag")),
+                        CellValue::from_str(text),
+                    );
+                }
+                Ok::<_, ()>(())
+            })
+            .unwrap();
+        branch
+    };
+    let first = stage("initial");
+    branches.commit(first).unwrap();
+    let snapshot = || {
+        let tx = store.begin_read().unwrap();
+        [
+            "Superblock",
+            "Roots",
+            "Stale",
+            "CellTrie",
+            "IndexTrie",
+            "BitmapTrie",
+            "BitmapContainer",
+            "Cell",
+            "Index",
+        ]
+        .map(|table| {
+            scan_prefix(&tx, Table(table), vec![])
+                .unwrap()
+                .collect::<golemdb_storage::Result<Vec<_>>>()
+                .unwrap()
+        })
+    };
+    let before = snapshot();
+    let discarded = stage("discarded");
+    branches.seal(discarded).unwrap();
+    branches.discard(discarded).unwrap();
+    assert_eq!(snapshot(), before);
+    let winner = stage("winner");
+    let loser = stage("loser");
+    branches.seal(winner).unwrap();
+    branches.seal(loser).unwrap();
+    assert_eq!(snapshot(), before);
+    branches.commit(winner).unwrap();
+    let published = snapshot();
+    assert!(matches!(
+        branches.commit(loser),
+        Err(golemdb_branch::BranchError::Conflict)
+    ));
+    assert_eq!(snapshot(), published);
+}
