+fn bitmap_roots(tx: &impl ReadTransaction) -> Vec<(Vec<u8>, RootRef<BITMAP_TRIE_PATH_BYTES>)> {
+    scan_prefix(tx, itables::INDEX, vec![])
+        .unwrap()
+        .map(|row| {
+            let (term, value) = row.unwrap();
+            let ns = IndexTerm::decode(&term)
+                .unwrap()
+                .routing_path(&HASH)
+                .to_vec();
+            (ns, RootRef::decode(&value).unwrap())
+        })
+        .collect()
