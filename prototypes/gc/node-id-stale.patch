+fn stored(tx: &impl ReadTransaction) -> BTreeSet<(Table, Vec<u8>)> {
+    let mut rows = BTreeSet::new();
+    for table in [
+        tables::CELL_TRIE,
+        itables::INDEX_TRIE,
+        itables::BITMAP_TRIE,
+        itables::BITMAP_CONTAINER,
+    ] {
+        for row in scan_prefix(tx, table, vec![]).unwrap() {
