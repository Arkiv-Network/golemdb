+#[test]
+#[ignore = "spawned by the durable restart test"]
+fn durable_worker() {
+    let directory = std::env::var("NODE_ID_TEST_DB").unwrap();
+    let phase = std::env::var("NODE_ID_TEST_PHASE").unwrap();
+    let store = golemdb_storage_mdbx::MdbxStore::open(&directory).unwrap();
+    let config = golemdb_api::OpenConfig::new(golemdb_api::Genesis::new(
+        golemdb_merkle::HashAlgorithm::Keccak256,
+        golemdb_api::CellLimits {
+            max_cell_name_len: 64,
+            max_str_len: 1024,
+            max_bytes_len: 4096,
+        },
+    ));
+    let opened = golemdb_api::Database::from_store(store.clone(), &config);
+    if phase == "wrong-layout" {
+        assert!(matches!(
+            opened,
+            Err(golemdb_api::OpenError::UnsupportedFormat(_))
+        ));
+        return;
+    }
+    let _api = opened.unwrap();
+    let branches = Branches::new(store.clone(), HASH).unwrap();
+    let steps = match phase.as_str() {
+        "init" => 20,
+        "resume" => 10,
+        "drain" => 400,
+        _ => panic!("phase"),
+    };
+    for step in 0..steps {
+        let branch = branches.begin().unwrap();
+        branches
+            .write(branch, |cells| {
+                if phase != "drain" {
+                    for id in 64..576 {
+                        let id = ((id % 3) << 16) + id;
+                        for name in [b"tag".as_slice(), b"owner"] {
+                            let text = format!("{phase}-{step}");
+                            let value = CellValueRef::new(CellType::Str, text.as_bytes(), true)
+                                .unwrap()
+                                .into();
+                            cells.put(CellKey::new(id, CellNameRef::raw(name)), value);
+                        }
+                    }
+                }
+                Ok::<_, ()>(())
+            })
+            .unwrap();
+        branches.commit(branch).unwrap();
+    }
+    let read = store.begin_read().unwrap();
+    let head = golemdb_branch::read_head_state(&read).unwrap();
+    let roots = read_roots(&read, head.commit_id).unwrap().unwrap();
+    let mut live = BTreeSet::new();
+    reachable(
+        &read,
+        head.commit_id.get(),
+        &bitmap_roots(&read),
+        true,
+        &mut live,
+    );
+    assert!(live.is_subset(&stored(&read)));
+    if phase == "drain" {
+        let window: u64 = std::env::var("GOLEMDB_GC_W")
+            .unwrap_or_else(|_| "0".into())
+            .parse()
+            .unwrap();
+        for row in scan_prefix(&read, Table("Stale"), vec![]).unwrap() {
+            let (key, _) = row.unwrap();
+            assert!(
+                u64::from_be_bytes(key[..8].try_into().unwrap())
+                    > head.commit_id.get().saturating_sub(window)
+            );
+        }
+    }
+    assert_eq!(roots.state.hash(&HASH), head.state_root);
+}
