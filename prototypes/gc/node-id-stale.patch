+//! Experimental physical addressing for the GC comparison. Not a storage format promise.
+use std::sync::OnceLock;
+
+use golemdb_storage::{StorageError, Table, WriteTransaction};
+
+/// Selected once per process. Use a separate process for each layout.
+pub fn node_ids() -> bool {
+    static IDS: OnceLock<bool> = OnceLock::new();
+    *IDS.get_or_init(|| match std::env::var("GOLEMDB_LAYOUT").as_deref() {
+        Err(std::env::VarError::NotPresent) | Ok("version-path") => false,
+        Ok("node-id") => true,
+        other => panic!("GOLEMDB_LAYOUT must be version-path or node-id: {other:?}"),
+    })
+}
+
+/// Allocate in the caller's transaction, including seal buffers. Discarded or
+/// losing seals do not advance the persisted counter or publish their IDs.
+pub fn allocate(tx: &mut impl WriteTransaction) -> golemdb_storage::Result<u64> {
+    const META: Table = Table("Superblock");
+    const NEXT: &[u8] = b"experimental_next_node_id";
+    let next =
+        match tx.get(META, NEXT)? {
+            None => 1,
+            Some(bytes) => u64::from_be_bytes(bytes.try_into().map_err(|_| {
+                StorageError::Backend("malformed experimental node ID counter".into())
+            })?),
+        };
+    let after = next
+        .checked_add(1)
+        .filter(|_| next != 0)
+        .ok_or_else(|| StorageError::Backend("experimental node ID exhausted".into()))?;
+    tx.put(META, NEXT, &after.to_be_bytes())?;
+    Ok(next)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use golemdb_storage::{MemoryStore, Store};
+
+    #[test]
+    fn allocation_is_transactional_and_checked() {
+        let store = MemoryStore::new();
+        let mut tx = store.begin_write().unwrap();
+        assert_eq!(allocate(&mut tx).unwrap(), 1);
+        assert_eq!(allocate(&mut tx).unwrap(), 2);
+        tx.abort();
+        let mut tx = store.begin_write().unwrap();
+        assert_eq!(allocate(&mut tx).unwrap(), 1);
+        tx.commit().unwrap();
+        let mut tx = store.begin_write().unwrap();
+        assert_eq!(allocate(&mut tx).unwrap(), 2);
+        tx.put(
+            Table("Superblock"),
+            b"experimental_next_node_id",
+            &u64::MAX.to_be_bytes(),
+        )
+        .unwrap();
+        assert!(allocate(&mut tx).is_err());
+        tx.put(Table("Superblock"), b"experimental_next_node_id", &[0])
+            .unwrap();
+        assert!(allocate(&mut tx).is_err());
+    }
+}
